# Puerto del servidor
PORT=3000

# URL de Supabase (ej: https://xyzcompany.supabase.co) en API URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de Supabase (Anon Key o Service Role Key) En Secret Key
# Recomendado para backend: Service Role Key (bypassa RLS) o Anon Key
SUPABASE_KEY=tu-supabase-anon-o-service-role-key

# Secreto para JWT Generar clave 
JWT_SECRET=super_secret_jwt_key_rrhh_2026

# Origen permitido para CORS (Frontend de Angular)
FRONTEND_URL=http://localhost:4200
